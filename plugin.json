{
    "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
    "name": "vsco-mcp",
    "version": "0.2.0",
    "description": "Connect to VSCO's existing MCP service with account authorization.",
    "author": { "name": "VSCO" },
    "homepage": "https://vsco.co",
    "keywords": ["photo", "photographer", "photography", "crm", "vsco", "invoice", "leads", "workflow", "payments"],
    "extensions": {
        "com.openai": {
            "interface": {
                "displayName": "VSCO Workspace MCP",
                "shortDescription": "Connect VSCO Workspace tools",
                "longDescription": "Connect to VSCO's MCP service, initially VSCO Workspace, to access the tools available to your authorized account. Requires a VSCO One subscription.",
                "developerName": "VSCO",
                "category": "Productivity",
                "capabilities": ["Read", "Write"],
                "defaultPrompt": ["Show me my open leads in my VSCO", "Show me my open invoices in VSCO"],
                "websiteURL": "https://vsco.co",
                "privacyPolicyURL": "https://www.vsco.co/about/privacy-policy",
                "termsOfServiceURL": "https://www.vsco.co/about/terms-of-use",
                "brandColor": "#000000",
                "composerIcon": "./icon.png",
                "logo": "./icon.png"
            }
        }
    }
}
